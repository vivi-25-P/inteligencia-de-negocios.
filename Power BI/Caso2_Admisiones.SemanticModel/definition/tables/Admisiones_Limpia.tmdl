table Admisiones_Limpia
	lineageTag: 32c46f22-4d46-4793-b10e-5921fb891557

	measure 'Registros limpios' = COUNTROWS(Admisiones_Limpia)
		formatString: #,0
		lineageTag: 38102d29-b6b6-4b4c-9e26-d191f63c85bd

	measure '% del total limpio' = DIVIDE([Registros limpios], CALCULATE([Registros limpios], ALL(Admisiones_Limpia)))
		formatString: 0.00%
		lineageTag: 0cf686dc-b3b5-48dd-a213-98ffb0f4ec7e

	measure '% matriculado limpio' = DIVIDE(CALCULATE([Registros limpios], Admisiones_Limpia[estado_proceso] = "Matriculado"), [Registros limpios])
		formatString: 0.00%
		lineageTag: 62851ca2-47fb-4971-8bcc-31dfe9a0179e

