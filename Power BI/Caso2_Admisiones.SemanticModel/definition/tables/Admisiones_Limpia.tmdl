	partition Admisiones_Limpia = m
		mode: import
		source =
				let
				    Origen = Admisiones_Original,
				    SinDuplicados = Table.Distinct(Origen),
				    Categoricas = {"programa", "modalidad", "estado_proceso", "documentos_completos", "ciudad_residencia", "asesor", "periodo_academico"},
				    Recortado = Table.TransformColumns(SinDuplicados, List.Transform(Categoricas, each {_, Text.Trim, type text})),
				    Reglas = Table.ToRows(Table.SelectColumns(Reglas_Unificacion, {"columna", "valor_original", "valor_nuevo"})),
				    Unificado = List.Accumulate(Reglas, Recortado, (tabla, r) => Table.ReplaceValue(tabla, r{1}, r{2}, Replacer.ReplaceValue, {r{0}})),
				    // periodo_academico conserva el texto de origen; el código entero sale de Periodo_Codigos
				    ConPeriodo = CodificarPeriodo(Unificado)
				in
				    ConPeriodo

	annotation PBI_ResultType = Table

