	partition Admisiones_Original = m
		mode: import
		source =
				let
				    Ruta = "C:\Users\USUARIO\Documents\ESPECIALIZACIÓN\03. Inteligencia_de_negocios\Caso 2 - Admisiones universitarias\Caso2_Admisiones_Universitarias.csv",
				    Origen = Csv.Document(File.Contents(Ruta), [Delimiter = ",", Columns = 15, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    ComoTexto = Table.TransformColumnTypes(Encabezados, List.Transform(Table.ColumnNames(Encabezados), each {_, type text})),
				    PuntajeNum = Table.AddColumn(ComoTexto, "puntaje_num", each try Number.FromText([puntaje_admision], "en-US") otherwise null, type nullable number),
				    ValorNum = Table.AddColumn(PuntajeNum, "valor_num", each try Number.FromText([valor_matricula_cop], "en-US") otherwise null, type nullable number),
				    FormatoSol = Table.AddColumn(ValorNum, "formato_fecha_solicitud", each FormatoFecha([fecha_solicitud]), type text),
				    FormatoMat = Table.AddColumn(FormatoSol, "formato_fecha_matricula", each FormatoFecha([fecha_matricula]), type text),
				    FechaSol = Table.AddColumn(FormatoMat, "fecha_solicitud_dt", each ConvertirFecha([fecha_solicitud]), type nullable date),
				    FechaMat = Table.AddColumn(FechaSol, "fecha_matricula_dt", each ConvertirFecha([fecha_matricula]), type nullable date),
				    MesSol = Table.AddColumn(FechaMat, "mes_solicitud", each if [fecha_solicitud_dt] = null then null else Date.ToText([fecha_solicitud_dt], "yyyy-MM"), type nullable text),
				    MatriculadoExacto = Table.AddColumn(MesSol, "matriculado_etiqueta_exacta", each if [estado_proceso] = "Matriculado" then 1 else 0, Int64.Type)
				in
				    MatriculadoExacto

	annotation PBI_ResultType = Table

