table Admisiones_Original
	lineageTag: 21b24db0-0866-42c3-937a-68e96d3a3d73

	measure Registros = COUNTROWS(Admisiones_Original)
		formatString: #,0
		lineageTag: 7d275712-a9ba-472e-9def-ea131f2c91fd

	measure '% del total' = DIVIDE([Registros], CALCULATE([Registros], ALL(Admisiones_Original)))
		formatString: 0.00%
		lineageTag: d1e574e2-0c18-4e34-babf-5de27994cc85

	measure 'IDs distintos' = DISTINCTCOUNT(Admisiones_Original[registro_id])
		formatString: #,0
		lineageTag: 53818fae-a779-4b90-a471-0beeacf6a679

	measure 'Aspirantes distintos' = CALCULATE(DISTINCTCOUNT(Admisiones_Original[aspirante_id]), Admisiones_Original[aspirante_id] <> "")
		formatString: #,0
		lineageTag: 3419ebe0-c834-4429-b00e-94cc0eaf5145

	measure 'Filas en duplicados' = SUMX(Duplicados, Duplicados[veces])
		formatString: #,0
		lineageTag: 966e9e87-a9b4-420e-ab52-4fa06871cd4a

	measure 'Repeticiones adicionales' = SUMX(Duplicados, Duplicados[veces] - 1)
		formatString: #,0
		lineageTag: 12b2c8a4-1e11-40e2-9d04-2928bc470df4

	measure 'Puntajes Pendiente' = CALCULATE([Registros], Admisiones_Original[puntaje_admision] = "Pendiente")
		formatString: #,0
		lineageTag: 71af77ab-17c0-4a14-80c4-a4437c3bfae3

	measure 'Valores por definir' = CALCULATE([Registros], Admisiones_Original[valor_matricula_cop] = "por definir")
		formatString: #,0
		lineageTag: 9817dcd3-cd61-4ae7-a55f-504fae39c374

	measure 'Fecha matrícula No aplica' = CALCULATE([Registros], Admisiones_Original[fecha_matricula] = "No aplica")
		formatString: #,0
		lineageTag: 9e23c9fc-9e60-487b-a541-a9573f5c27db

	measure Matriculados = CALCULATE([Registros], Admisiones_Original[estado_proceso] = "Matriculado")
		formatString: #,0
		lineageTag: 7c8ce6bc-5746-4a08-a7ee-cdf2f4809f25

	measure 'Matriculados con documentos incompletos' = CALCULATE([Registros], Admisiones_Original[estado_proceso] = "Matriculado", Admisiones_Original[documentos_completos] IN {"No", "Pendiente"})
		formatString: #,0
		lineageTag: df0dcaab-3791-4347-9e17-6871d54fa910

	measure 'No matriculados con valor' = CALCULATE([Registros], Admisiones_Original[estado_proceso] <> "Matriculado", NOT ISBLANK(Admisiones_Original[valor_num]))
		formatString: #,0
		lineageTag: 23725794-9be5-4051-8752-cecf41171bee

	measure 'Matriculados sin valor' = CALCULATE([Registros], Admisiones_Original[estado_proceso] = "Matriculado", ISBLANK(Admisiones_Original[valor_num]))
		formatString: #,0
		lineageTag: c5299bf5-1e09-47f6-bb5a-7b00a72763cf

	measure 'Periodo 2025-2 con solicitud 2026' = COUNTROWS(FILTER(Admisiones_Original, Admisiones_Original[periodo_academico] = "2025-2" && YEAR(Admisiones_Original[fecha_solicitud_dt]) = 2026)) + 0
		formatString: #,0
		lineageTag: eeee1317-2fd3-4496-8539-719ed6d1f42b

	measure '% matriculado solo etiqueta exacta' = DIVIDE(SUM(Admisiones_Original[matriculado_etiqueta_exacta]), [Registros])
		formatString: 0.00%
		lineageTag: 4704a9ce-17a3-45a1-bc7e-17c76fb8eec1

	measure 'Puntaje - n' = COUNT(Admisiones_Original[puntaje_num])
		formatString: #,0
		lineageTag: 69d0a94e-5ff0-40a3-b4ac-852dd9108e9f

	measure 'Puntaje - mínimo' = MIN(Admisiones_Original[puntaje_num])
		formatString: 0.00
		lineageTag: 67fdb1ea-31c5-4b84-870e-ea6d573caaa9

	measure 'Puntaje - máximo' = MAX(Admisiones_Original[puntaje_num])
		formatString: 0.00
		lineageTag: 1d4f104b-3b04-4e4c-a031-fc50d30bc88c

	measure 'Puntaje - promedio' = AVERAGE(Admisiones_Original[puntaje_num])
		formatString: 0.00
		lineageTag: a8159f6a-620c-4f28-8d83-8663b55e2a67

	measure 'Puntaje - mediana' = MEDIAN(Admisiones_Original[puntaje_num])
		formatString: 0.00
		lineageTag: 3467c9e3-3cf7-4d67-811c-a9672aa7e42a

	measure 'Puntaje - atípicos' =
			VAR Datos = FILTER(Admisiones_Original, NOT ISBLANK(Admisiones_Original[puntaje_num]))
			VAR Q1 = PERCENTILEX.INC(Datos, Admisiones_Original[puntaje_num], 0.25)
			VAR Q3 = PERCENTILEX.INC(Datos, Admisiones_Original[puntaje_num], 0.75)
			VAR RIC = Q3 - Q1
			RETURN
			    COUNTROWS(FILTER(Datos, Admisiones_Original[puntaje_num] < Q1 - 1.5 * RIC || Admisiones_Original[puntaje_num] > Q3 + 1.5 * RIC)) + 0
		formatString: #,0
		lineageTag: 63dd4824-dd03-42d8-bafc-72dcd10db684

	measure 'Valor - n' = COUNT(Admisiones_Original[valor_num])
		formatString: #,0
		lineageTag: 3ef3f527-06c4-444e-8484-41a7bcb82b40

	measure 'Valor - mínimo' = MIN(Admisiones_Original[valor_num])
		formatString: \$#,0.00
		lineageTag: 10e372ce-0a6a-44f7-b84e-f8ceb4f9be7b

	measure 'Valor - máximo' = MAX(Admisiones_Original[valor_num])
		formatString: \$#,0.00
		lineageTag: 57be49cb-9c39-48cc-adca-4ffe3c11ee79

	measure 'Valor - promedio' = AVERAGE(Admisiones_Original[valor_num])
		formatString: \$#,0.00
		lineageTag: 4b1f33ec-5c30-499d-b368-708ec80d3994

	measure 'Valor - mediana' = MEDIAN(Admisiones_Original[valor_num])
		formatString: \$#,0.00
		lineageTag: 802d43f5-0078-451e-b53b-27054c1ee379

	measure 'Valor - atípicos' =
			VAR Datos = FILTER(Admisiones_Original, NOT ISBLANK(Admisiones_Original[valor_num]))
			VAR Q1 = PERCENTILEX.INC(Datos, Admisiones_Original[valor_num], 0.25)
			VAR Q3 = PERCENTILEX.INC(Datos, Admisiones_Original[valor_num], 0.75)
			VAR RIC = Q3 - Q1
			RETURN
			    COUNTROWS(FILTER(Datos, Admisiones_Original[valor_num] < Q1 - 1.5 * RIC || Admisiones_Original[valor_num] > Q3 + 1.5 * RIC)) + 0
		formatString: #,0
		lineageTag: c1970f07-dc24-46b9-8cd2-64c8f8625739

