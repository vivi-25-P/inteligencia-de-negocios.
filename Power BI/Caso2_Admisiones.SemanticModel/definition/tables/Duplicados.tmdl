	partition Duplicados = m
		mode: import
		source =
				let
				    Origen = Admisiones_Original,
				    Columnas = List.FirstN(Table.ColumnNames(Origen), 15),
				    Agrupado = Table.Group(Table.SelectColumns(Origen, Columnas), Columnas, {{"veces", each Table.RowCount(_), Int64.Type}}),
				    Repetidas = Table.SelectRows(Agrupado, each [veces] > 1)
				in
				    Repetidas

	annotation PBI_ResultType = Table

