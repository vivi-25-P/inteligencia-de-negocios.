		summarizeBy: none
		sourceColumn: validacion

		annotation SummarizationSetBy = User

	partition Registro_Transformaciones = m
		mode: import
		source =
				let
				    Orig = Admisiones_Original,
				    Categoricas = {"programa", "modalidad", "estado_proceso", "documentos_completos", "ciudad_residencia", "asesor", "periodo_academico"},
				    Contar = (t as table, c as text, v as text) as number => List.Count(List.Select(Table.Column(t, c), each _ = v)),
				    // 1. Duplicados exactos
				    T1 = Table.Buffer(Table.Distinct(Orig)),
				    FilaDup = [paso = "Eliminar filas duplicadas exactas", columna = "(todas)", valor_original = "Filas idénticas", valor_nuevo = "Una sola fila",
				        registros_afectados = Table.RowCount(Orig) - Table.RowCount(T1), filas_antes = Table.RowCount(Orig), filas_despues = Table.RowCount(T1),
				        conteo_nuevo_antes = null, conteo_nuevo_despues = null,
				        validacion = if Table.RowCount(Table.Distinct(T1)) = Table.RowCount(T1) then "OK" else "Revisar"],
				    // 2. Recorte de espacios
				    T2 = Table.Buffer(Table.TransformColumns(T1, List.Transform(Categoricas, each {_, Text.Trim, type text}))),
				    FilasTrim = List.Select(List.Transform(Categoricas, (c) => [paso = "Recortar espacios", columna = c,
				        valor_original = "Espacios al inicio o al final", valor_nuevo = "Sin espacios",
				        registros_afectados = List.Count(List.Select(Table.Column(T1, c), each _ <> Text.Trim(_))),
				        filas_antes = Table.RowCount(T1), filas_despues = Table.RowCount(T2), conteo_nuevo_antes = null, conteo_nuevo_despues = null,
				        validacion = if List.Count(List.Select(Table.Column(T2, c), each _ <> Text.Trim(_))) = 0 then "OK" else "Revisar"]),
				        each [registros_afectados] > 0),
				    // 3. Reglas de unificación (las mismas que usa Admisiones_Limpia)
				    Reglas = Table.ToRows(Table.SelectColumns(Reglas_Unificacion, {"columna", "valor_original", "valor_nuevo"})),
				    Acumulado = List.Accumulate(Reglas, [tabla = T2, filas = {}], (estado, r) =>
				        let
				            t = estado[tabla],
				            afectados = Contar(t, r{0}, r{1}),
				            antes = Contar(t, r{0}, r{2}),
				            t2 = Table.Buffer(Table.ReplaceValue(t, r{1}, r{2}, Replacer.ReplaceValue, {r{0}})),
				            despues = Contar(t2, r{0}, r{2}),
				            restantes = Contar(t2, r{0}, r{1}),
				            fila = [paso = "Unificar categoría", columna = r{0}, valor_original = if r{1} = "" then "(vacío)" else r{1}, valor_nuevo = r{2},
				                registros_afectados = afectados, filas_antes = Table.RowCount(t), filas_despues = Table.RowCount(t2),
				                conteo_nuevo_antes = antes, conteo_nuevo_despues = despues,
				                validacion = if despues = antes + afectados and restantes = 0 then "OK" else "Revisar"]
				        in
				            [tabla = t2, filas = estado[filas] & {fila}]),
				    Final = Acumulado[tabla],
				    // 3b. Código entero del periodo: el texto de origen se conserva en periodo_academico
				    FinalCod = Table.Buffer(CodificarPeriodo(Final)),
				    FilasPeriodo = List.Transform(Table.ToRows(Periodo_Codigos), (p) =>
				        let
				            afectados = Contar(Final, "periodo_academico", p{0}),
				            conCodigo = Table.RowCount(Table.SelectRows(FinalCod, each [periodo_academico] = p{0} and [periodo_codigo] = p{1})),
				            totalCodigo = List.Count(List.Select(FinalCod[periodo_codigo], each _ = p{1}))
				        in
				            [paso = "Codificar periodo", columna = "periodo_academico", valor_original = p{0}, valor_nuevo = Text.From(p{1}),
				             registros_afectados = afectados, filas_antes = Table.RowCount(Final), filas_despues = Table.RowCount(FinalCod),
				             conteo_nuevo_antes = null, conteo_nuevo_despues = totalCodigo,
				             validacion = if conCodigo = afectados then "OK" else "Revisar"]),
				    SinCodigo = List.Count(List.Select(FinalCod[periodo_codigo], each _ = null)),
				    FilaSinCodigo = [paso = "Comprobar códigos de periodo", columna = "periodo_codigo", valor_original = "Valores sin equivalencia",
				        valor_nuevo = "Se señalan, sin código", registros_afectados = SinCodigo, filas_antes = Table.RowCount(FinalCod),
				        filas_despues = Table.RowCount(FinalCod), conteo_nuevo_antes = null, conteo_nuevo_despues = null,
				        validacion = if SinCodigo = 0 then "OK" else Text.From(SinCodigo) & " sin código"],
				    // 4. Conversión de tipos: un error es un valor con contenido que no se pudo convertir
				    Conversiones = {
				        {"fecha_solicitud", "fecha_solicitud_dt", "Fecha", {}},
				        {"fecha_matricula", "fecha_matricula_dt", "Fecha", {"No aplica"}},
				        {"puntaje_admision", "puntaje_num", "Número", {"Pendiente"}},
				        {"valor_matricula_cop", "valor_num", "Número", {"por definir"}}},
				    FilasConv = List.Transform(Conversiones, (cv) =>
				        let
				            pares = List.Zip({Table.Column(Final, cv{0}), Table.Column(Final, cv{1})}),
				            convertidos = List.Count(List.Select(pares, each _{1} <> null)),
				            errores = List.Count(List.Select(pares, each _{1} = null and not List.Contains(cv{3} & {""}, Text.Trim(_{0}))))
				        in
				            [paso = "Convertir tipo de dato", columna = cv{0}, valor_original = "Texto", valor_nuevo = cv{2} & " (" & cv{1} & ")",
				             registros_afectados = convertidos, filas_antes = Table.RowCount(Final), filas_despues = Table.RowCount(Final),
				             conteo_nuevo_antes = null, conteo_nuevo_despues = null,
				             validacion = if errores = 0 then "OK" else Text.From(errores) & " sin convertir"]),
				    // 5. El resultado de este registro debe ser idéntico a Admisiones_Limpia
				    Limpia = Table.Buffer(Admisiones_Limpia),
				    Comprobacion = [paso = "Comprobación final", columna = "(todas)", valor_original = "Resultado de este registro", valor_nuevo = "Admisiones_Limpia",
				        registros_afectados = null, filas_antes = Table.RowCount(Final), filas_despues = Table.RowCount(Limpia),
				        conteo_nuevo_antes = null, conteo_nuevo_despues = null,
				        validacion = if Table.RowCount(FinalCod) = Table.RowCount(Limpia)
				            and Table.RowCount(Table.Distinct(Table.Combine({FinalCod, Limpia}))) = Table.RowCount(FinalCod) then "OK" else "Revisar"],
				    Filas = {FilaDup} & FilasTrim & Acumulado[filas] & FilasPeriodo & {FilaSinCodigo} & FilasConv & {Comprobacion},
				    Tabla = Table.FromRecords(Filas),
				    Tipos = Table.TransformColumnTypes(Tabla, {{"paso", type text}, {"columna", type text}, {"valor_original", type text}, {"valor_nuevo", type text},
				        {"registros_afectados", Int64.Type}, {"filas_antes", Int64.Type}, {"filas_despues", Int64.Type},
				        {"conteo_nuevo_antes", Int64.Type}, {"conteo_nuevo_despues", Int64.Type}, {"validacion", type text}}),
				    ConOrden = Table.AddIndexColumn(Tipos, "orden", 1, 1, Int64.Type),
				    Ordenada = Table.ReorderColumns(ConOrden, {"orden", "paso", "columna", "valor_original", "valor_nuevo", "registros_afectados",
				        "filas_antes", "filas_despues", "conteo_nuevo_antes", "conteo_nuevo_despues", "validacion"})
				in
				    Ordenada

	annotation PBI_ResultType = Table

