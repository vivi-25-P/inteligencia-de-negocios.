table Registro_Transformaciones
	lineageTag: dcbfdd11-669d-49ee-94e4-1282fc8be0a4

	measure 'Pasos registrados' = COUNTROWS(Registro_Transformaciones)
		formatString: #,0
		lineageTag: ae70f11a-ff3f-4ebf-a6ee-4d7966a319d8

	measure 'Pasos validados OK' = CALCULATE(COUNTROWS(Registro_Transformaciones), Registro_Transformaciones[validacion] = "OK") + 0
		formatString: #,0
		lineageTag: c8869b4f-0f5a-4673-87bb-27e793e61f4b

	measure 'Pasos por revisar' = [Pasos registrados] - [Pasos validados OK]
		formatString: #,0
		lineageTag: 5205e7ab-d1da-470a-8789-6576745d274a

